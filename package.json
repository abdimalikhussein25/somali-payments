{
  "name": "somali-payments",
  "version": "0.1.0",
  "description": "Accept EVC Plus, Zaad and Sahal payments in Node.js via WaafiPay. Typed, tested, zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "somalia",
    "evc-plus",
    "zaad",
    "sahal",
    "waafipay",
    "mobile-money",
    "payments"
  ],
  "author": "Abdimalik Salad Hussein",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
